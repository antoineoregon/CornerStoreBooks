{
  "name": "user-service",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "frontend": "npx serve -l 5000 ../frontend",
    "recommendations": "node ../personalized_feed/server.js",
    "tags": "node ../tag_service/server.js",
    "preferences": "node ../update_preferences/server.js",
    "audit": "node ../audit_service/server.js",
    "dev": "concurrently \"npm run start\" \"npm run frontend\" \"npm run recommendations\" \"npm run tags\" \"npm run preferences\" \"npm run audit\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}